DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

PETROLINE_LOGIN=
PETROLINE_PASS=
PETROLINE_VALUE_DIVISOR=1000
# Новий API Petroline (картки й транзакції): звичайний пароль, не SHA256. Якщо порожні — беруться PETROLINE_LOGIN/PETROLINE_PASS
PETROLINE_V2_LOGIN=
PETROLINE_V2_PASSWORD=
# Джерело транзакцій Petroline: порожньо або v2 — новий API; legacy — старий (fms.petroline.in.ua:8055)
PETROLINE_API=

UPG_LOGIN =
UPG_PASSWORD =

UKRNAFTA_TOKEN=
UKRNAFTA_HOLDER_ID=
UKRNAFTA_ACCOUNT_ID=
CARD_NUMBER=    #номер картки для тестування, наприклад: 7921000902444

# Бекап бази налаштовується не тут, а в /etc/default/fuelcards-backup на сервері (зразок: deploy/fuelcards-backup.default).
